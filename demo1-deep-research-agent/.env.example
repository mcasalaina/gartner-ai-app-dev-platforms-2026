# Local FastAPI configuration
FOUNDRY_AGENT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/agents/bank-deep-research/endpoint/protocols/invocations
FOUNDRY_AGENT_API_VERSION=v1
IMAGE_MODEL_ENDPOINT=https://<image-account>.cognitiveservices.azure.com/
IMAGE_MODEL_DEPLOYMENT=flux-1-1-pro
SPEECH_REGION=westus
SPEECH_ENDPOINT=https://<speech-account>.cognitiveservices.azure.com/
SPEECH_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<speech-account>
SPEECH_VOICE=en-US-AvaMultilingualNeural
APPLICATIONINSIGHTS_CONNECTION_STRING=
ALLOWED_ORIGIN=http://localhost:5173

# Used only by scripts/setup-webiq-toolbox.sh. Never expose it to the browser.
WEBIQ_API_KEY=

# Optional service-principal variables for running DefaultAzureCredential in Docker.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
